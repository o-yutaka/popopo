# Gloo AI Studio — official OAuth2 client-credentials flow.
# Create Client ID + Client Secret in Gloo AI Studio.
GLOO_CLIENT_ID=
GLOO_CLIENT_SECRET=
GLOO_TOKEN_URL=https://platform.ai.gloo.com/oauth2/token
GLOO_BASE_URL=https://platform.ai.gloo.com/ai/v2
GLOO_MODEL=gloo-openai-gpt-5-mini
GLOO_CHAT_PATH=/chat/completions

# Optional short-lived token for local/manual testing only.
# Production evidence should use Client ID + Client Secret so tokens refresh.
GLOO_ACCESS_TOKEN=

# YouVersion Platform
YVP_APP_KEY=
YOUVERSION_BASE_URL=https://api.youversion.com/v1
YOUVERSION_BIBLE_ID=3034
